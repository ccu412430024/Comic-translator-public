{
  "manifest_version": 3,
  "name": "漫畫翻譯本機測試",
  "version": "0.22.2",
  "description": "擷取目前可見的漫畫，使用本機偵測、OCR、消字與排字，並覆蓋回原位置。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "optional_permissions": ["webRequest"],
  "optional_host_permissions": ["https://bw-bv-epubs.bookwalker.jp/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "漫畫翻譯", "default_popup": "popup.html"},
  "key": ""
}
